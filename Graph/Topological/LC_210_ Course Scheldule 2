

class Solution {
public:
    vector<int> findOrder(int n, vector<vector<int>>& pre) {
         unordered_map<int , vector<int>>adj;
         vector<int>indeg(n , 0);
         for(auto& i: pre){
            int v = i[0] , u = i[1];
            adj[u].push_back(v);
            indeg[v]++;
         }
         vector<int>ans;
         queue<int>q;
         for(int i = 0; i < n; i++){
              if(indeg[i] == 0) {
                ans.push_back(i) ;
                q.push(i);
              }
         }
         
         while(!q.empty()){
             auto node = q.front();
             q.pop();
            
             for(auto j: adj[node]){
                 indeg[j]--;
                 if(indeg[j] == 0) q.push(j) , ans.push_back(j);
             }
         }
         vector<int>temp;
         return ans.size() == n ? ans : temp ;
    }
};