// TC -> O(n) , SC-> O(n)


class Solution {
public:
    int trap(vector<int>& h) {
        int n= h.size();
        int ans=0;
        vector<int>left(n , 0) , right(n, 0);
        left[0]= h[0];
        for(int i=1;i<n;i++) left[i]= max(left[i-1], h[i] );
        right[n-1]= h[n-1];
        for(int i=n-2;i>=0;i--) right[i]= max(right[i+1] , h[i]);
        for(int i=0;i<n;i++) ans+=min(left[i] , right[i]) - h[i];
        return ans;

